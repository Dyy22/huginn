# ==========================================
# Discord Bot & Webhook Credentials
# ==========================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APP_ID=your_discord_application_id_here
# Optional: Set Guild (Server) ID for instant slash command registration during testing
DISCORD_GUILD_ID=

# Webhook URL for Rich Embed CVE notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# Optional: Also let the bot post auto-alerts directly to a channel ID
DISCORD_ALERT_CHANNEL_ID=

# ==========================================
# NVD API & Tracker Settings
# ==========================================
# Optional but recommended: increases NVD rate limit from 5 req/30s to 50 req/30s
# Request free key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Poll interval (e.g. 15m, 30m, 1h)
POLL_INTERVAL=15m

# Minimum severity for auto-alerts: LOW, MEDIUM, HIGH, CRITICAL
MIN_SEVERITY=HIGH

# Comma-separated initial watched keywords/vendors (leave empty to track all HIGH/CRITICAL CVEs)
WATCH_KEYWORDS=openssh,fortinet,ivanti,linux,nginx,docker,kubernetes

# SQLite database path for deduplication & dynamic watchlist
DB_PATH=./cve_tracker.db
