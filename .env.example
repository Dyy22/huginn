# ==========================================
# Huginn — Discord Bot & Webhook Credentials
# ==========================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_APP_ID=your_discord_application_id_here

# Optional: Discord Webhook URL (if you also want alerts pushed via Webhook)
DISCORD_WEBHOOK_URL=

# ==========================================
# NVD API & Storage Settings
# ==========================================
# Optional: Increases NVD rate limit from 5 req/30s to 50 req/30s
# Request free key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# SQLite database path (stores watched severities, news categories, alert channels, intervals & seen items)
DB_PATH=./cve_tracker.db
